// ============================================================================
//  文件名  : synth_board12.cst
//  功能    : 12 键电子琴板级约束
//  板卡    : Sipeed Tang Nano 20K (GW2AR-18)
//
//  ── 引脚依据（重要）──────────────────────────────────────────────
//  下列引脚全部来自**官方例程的 .cst 文件**，不是估算：
//      · rgb_lcd/.../tang_nano_20K_LCD.cst  → 27~32, 41, 42, 48, 77
//      · ws2812/src/ws2812.cst              → 79
//      · 引脚框图（Sipeed Wiki）             → 25（排针上，标注 LED_HS）
//
//  这些引脚原本是 RGB LCD / WS2812 的接口。**不用 LCD 屏时**即可作
//  普通 GPIO 使用 —— 本项目不用 LCD，所以全部可用。
//
//  ── 已占用/避开的引脚 ────────────────────────────────────────────
//      4       : 板载 27MHz 时钟
//      15~20   : 板载 6 颗 LED
//      33~40   : HDMI TMDS 差分 + LCD 数据线（复用，避开）
//      51      : PA_EN（功放使能）
//      54,55,56: I2S DIN / WS / BCK
//      69,70   : UART TX/RX
//      87,88   : 板载用户按键 / 复位按键（**不可占用**）
//
//  ── 按键接线（TTP223 触摸模块）──────────────────────────────────
//      TTP223 VCC → 板卡 3.3V
//      TTP223 GND → 板卡 GND
//      TTP223 I/O → 对应 key 引脚
//      TTP223 A/B 焊盘 → 都不焊（默认高有效，匹配 ACTIVE_LOW=0）
//
//  ── 修改方式 ────────────────────────────────────────────────────
//  只改下面 12 行 IO_LOC 的引脚号，Verilog 代码不用动
// ============================================================================

// ---- 板载 27MHz 时钟 ----
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ====================================================================
// 12 路按键输入（TTP223 触摸模块，高电平有效）
// 建议物理排布成钢琴键盘：白键 7 个 + 黑键 5 个
// ====================================================================
IO_LOC "key[0]"  27;
IO_PORT "key[0]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[1]"  28;
IO_PORT "key[1]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[2]"  29;
IO_PORT "key[2]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[3]"  30;
IO_PORT "key[3]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[4]"  31;
IO_PORT "key[4]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[5]"  26;    // [修正] 原为 32 —— 引脚图核实：32 未引出到 40pin 排针
IO_PORT "key[5]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[6]"  41;
IO_PORT "key[6]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[7]"  42;
IO_PORT "key[7]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[8]"  48;
IO_PORT "key[8]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[9]"  77;
IO_PORT "key[9]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[10]" 79;
IO_PORT "key[10]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "key[11]" 25;
IO_PORT "key[11]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// ====================================================================
// I2S 输出 → 板载 MAX98357A（引脚依据：官方 audio.cst）
// ====================================================================
IO_LOC "i2s_din" 54;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "i2s_lrck" 55;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "i2s_bck" 56;
IO_PORT "i2s_bck" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "pa_en" 51;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ====================================================================
// 板载 6 颗 LED（低电平点亮，引脚依据：官方 flow_led.cst）
// ====================================================================
IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
